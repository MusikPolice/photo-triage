# photo-triage configuration (docs/plan.md §9).
# Copy to .env and edit. Real environment variables override this file.
# Relative paths resolve from the repo root, where `just` runs the app.
# Commented-out variables show their default.

# --- Paths -------------------------------------------------------------------

# Photo library root (required). Dev: the read-only curated sample. NUC host:
# /mnt/pictures. In Docker it's bind-mounted to /photos.
PHOTO_DIR=/mnt/sample-pictures

# Where trashed files go (required). Must be outside PHOTO_DIR.
TRASH_DIR=./trash

# SQLite database and derived files (thumbnails, atlases, embeddings, layout).
# Default ./data; /data in the container, bind-mounted from a host folder.
DATA_DIR=./data

# --- Server ------------------------------------------------------------------

# Host port for the web UI and API.
# APP_PORT=8000

# --- Worker ------------------------------------------------------------------

# Cron schedule for incremental scans.
# SCAN_SCHEDULE=0 2 * * *

# Quiet-hours window for heavy stages, e.g. 22:00-07:00. Unset means always run.
# WORKER_WINDOW=

# Threads for ONNX/BLAS inference.
# WORKER_THREADS=4

# --- Models ------------------------------------------------------------------

# Ollama vision model for tagging.
# OLLAMA_MODEL=moondream

# CLIP model.
# CLIP_MODEL=ViT-B-32

# --- Thresholds --------------------------------------------------------------

# Composite quality score below which items are flagged.
# QUALITY_THRESHOLD=0.35

# Junk probability above which items are flagged.
# JUNK_THRESHOLD=0.7

# CLIP cosine similarity for duplicate linking.
# DUPLICATE_SIMILARITY_THRESHOLD=0.95

# Minimum face size in pixels.
# FACE_MIN_SIZE=40

# Face recognition distance threshold (default to be decided in Phase 6).
# FACE_MATCH_THRESHOLD=

# --- Media -------------------------------------------------------------------

# Frames sampled per video.
# VIDEO_SAMPLE_FRAMES=5

# Long-edge thumbnail size in pixels.
# THUMBNAIL_SIZE=400

# --- Files -------------------------------------------------------------------

# Days before trashed files are purged.
# TRASH_RETENTION_DAYS=30

# Apply queued metadata writes. false is a dry run: writes are logged, not made.
# EXIF_WRITES_ENABLED=false

# --- Auth (plan §10) ---------------------------------------------------------

# none (everyone is "anonymous") or forward_auth (Phase 8; not supported yet).
# AUTH_MODE=none

# Identity header set by the reverse proxy when AUTH_MODE=forward_auth.
# AUTH_USER_HEADER=X-Forwarded-Email

# --- Notifications -----------------------------------------------------------

# Optional webhook for milestones and errors. Unset means none are sent.
# NOTIFY_WEBHOOK_URL=
