# exiftool user config: the XMP-phototriage namespace (plan §6.10).
# Pass it first on the command line: exiftool -config exiftool.config ...
#
# The URI is written into every file that gets a marker, so it never changes.
# A new field goes in the same namespace; an incompatible change gets a new
# version in the URI.

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        phototriage => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::phototriage' },
        },
    },
);

%Image::ExifTool::UserDefined::phototriage = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-phototriage', 2 => 'Image' },
    NAMESPACE => { 'phototriage' => 'https://github.com/MusikPolice/photo-triage/xmp/1.0/' },
    WRITABLE  => 'string',
    # The review queues an item has been through, comma-separated: "quality,duplicates".
    Reviewed  => { },
);

1;  # end
