# Pins that mise.toml doesn't cover (dev-environment §2). Each is written only
# here: scripts/bootstrap.sh sources this file, CI loads it into the job's
# environment, and scripts/image_pins.sh passes it to docker/Dockerfile.
# Plain KEY=value lines, no quotes or spaces. Bumping a version means updating
# its checksum too.

# exiftool from SourceForge, which keeps every release (exiftool.org only
# serves the newest).
EXIFTOOL_VERSION=13.59
EXIFTOOL_SHA256=668ea3acececb7235fbd0f4900e72d5f12c9b07e5c778fd36cb1e9b5828fd65a

# The static amd64 build from johnvansickle.com, for both dev and the image.
FFMPEG_VERSION=7.0.2
FFMPEG_SHA256=abda8d77ce8309141f83ab8edf0596834087c52467f6badf376a6a2a4c87cf67

PRE_COMMIT_VERSION=4.6.2
